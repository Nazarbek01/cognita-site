# Copy these names into Netlify: Site configuration -> Environment variables.
# (For local testing you can copy this file to .env and fill it in. Never commit .env.)

# OpenAI: create a key at platform.openai.com -> API keys
OPENAI_API_KEY=
# Optional. Default is gpt-6-luna. Change it if your OpenAI account uses another model.
OPENAI_MODEL=

# Notion: internal integration token (notion.so/profile/integrations)
NOTION_TOKEN=
# The two databases inside the page "Cognita: данные сайта"
NOTION_RESULTS_DB=c0d61905265f470b9f57b7ce4f31b403
NOTION_FEEDBACK_DB=a1a1062da96c4e9fb938d6c0d465a60f

# Optional. Lets you test the real connections: GET /api/health?deep=1 with header x-admin-token
ADMIN_TOKEN=
